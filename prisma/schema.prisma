generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER
  RECEPTIONIST
  STAFF
  LAB_MANAGER
}

enum Status {
  ACTIVE
  INACTIVE
}

enum ClinicStatus {
  OPERATING
  NON_OPERATING
}

model User {
  userId        Int            @id //auth service user id
  email         String         @unique
  isPremium     Boolean        @default(false)
  premiumExpiry DateTime?
  ownedClinics  Clinic[]       @relation("ClinicOwner")
  clinicMembers ClinicMember[]
}

model Clinic {
  id            Int            @id @default(autoincrement())
  name          String
  location      String
  clinicStatus  ClinicStatus   @default(OPERATING)
  doctors       Doctor[]
  ownerId       Int
  owner         User           @relation("ClinicOwner", fields: [ownerId], references: [userId])
  clinicMembers ClinicMember[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model Doctor {
  id          Int     @id @default(autoincrement())
  firstName   String
  middleName  String?
  lastName    String?
  displayName String?
  email       String
  fees        Int

  specialization     String?
  qualification      String?
  registrationNumber String?
  experienceYears    Int?

  bio             String?
  profileImageUrl String?

  status Status @default(ACTIVE)

  clinicId Int
  clinic   Clinic @relation(fields: [clinicId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([id, clinicId])
}

model ClinicMember {
  userId   Int
  clinicId Int
  clinic   Clinic @relation(fields: [clinicId], references: [id])
  role     Role
  status   Status @default(ACTIVE)
  user     User   @relation(fields: [userId], references: [userId])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([userId, clinicId])
}
